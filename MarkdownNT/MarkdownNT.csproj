<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MarkdownNT</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.4</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="MarkdownNT.core\MarkdownNT.Core.csproj" />
    <ProjectReference Include="..\MarkdownNT.Plugin.Abstractions\MarkdownNT.Plugin.Abstractions.csproj" />
    <Compile Remove="MarkdownNT.core\**" />
    <Compile Remove="..\MarkdownNT.Plugin.Abstractions\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Override transitive vulnerable dependency on Tmds.DBus.Protocol (GHSA-xrw6-gwf8-vvr9). -->
    <!-- Bump to a non-vulnerable version; change the Version if you prefer another release. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.0" />
  </ItemGroup>
</Project>
