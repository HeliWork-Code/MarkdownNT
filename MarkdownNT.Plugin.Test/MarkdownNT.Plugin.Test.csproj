<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>MarkdownNT.Plugin.Test</AssemblyName>
    <RootNamespace>MarkdownNT.Plugin.Test</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownNT.Plugin.Abstractions\MarkdownNT.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="CopyTestPluginToEditor" AfterTargets="Build">
    <PropertyGroup>
      <EditorPluginDirectory>..\MarkdownNT\bin\$(Configuration)\net10.0\Plugins\MarkdownNT.Plugin.Test</EditorPluginDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(EditorPluginDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(EditorPluginDirectory)" />
    <Copy SourceFiles="$(TargetDir)MarkdownNT.Plugin.Abstractions.dll"
          DestinationFolder="$(EditorPluginDirectory)"
          Condition="Exists('$(TargetDir)MarkdownNT.Plugin.Abstractions.dll')" />
  </Target>
</Project>
