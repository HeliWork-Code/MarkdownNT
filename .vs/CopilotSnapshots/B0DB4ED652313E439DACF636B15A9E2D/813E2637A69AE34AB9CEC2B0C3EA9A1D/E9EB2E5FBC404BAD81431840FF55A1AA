using Avalonia.Controls;
using Avalonia.Controls.Documents;
using Avalonia.Media;
using Avalonia.Interactivity;
using System;

namespace MarkdownNT;

public partial class MainWindow : Window
{
    private bool _isDark;

    public MainWindow()
    {
        InitializeComponent();
        InputBox.TextChanged += InputBox_TextChanged;
        RenderPreview();
    }

    private void InputBox_TextChanged(object? sender, TextChangedEventArgs e)
    {
        RenderPreview();
        var text = InputBox.Text ?? string.Empty;
        WordCountText.Text = $"{text.Length}字 / {text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length}词";
    }

    private void RenderPreview()
    {
        PreviewPanel.Children.Clear();
        var text = InputBox.Text ?? string.Empty;
        var lines = text.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);

        foreach (var line in lines)
        {
            var paragraph = new TextBlock { TextWrapping = TextWrapping.Wrap };
            RenderInline(paragraph, line, _isDark);
            PreviewPanel.Children.Add(paragraph);
        }
    }

    private void NewFile_Click(object? sender, RoutedEventArgs e)
    {
        InputBox.Text = string.Empty;
        StatusText.Text = "已新建文件";
    }

    private void OpenFile_Click(object? sender, RoutedEventArgs e)
    {
        StatusText.Text = "打开文件功能尚未配置";
    }

    private void SaveFile_Click(object? sender, RoutedEventArgs e)
    {
        StatusText.Text = "保存文件功能尚未配置";
    }

    private void ToggleTheme_Click(object? sender, RoutedEventArgs e)
    {
        _isDark = !_isDark;
        if (Application.Current != null)
        {
            Application.Current.RequestedThemeVariant = _isDark
                ? Avalonia.Styling.ThemeVariant.Dark
                : Avalonia.Styling.ThemeVariant.Light;
        }

        RenderPreview();
        StatusText.Text = _isDark ? "已切换到深色主题" : "已切换到浅色主题";
    }

    private void RenderInline(TextBlock paragraph, string text, bool isDark)
    {
        int i = 0;
        while (i < text.Length)
        {
            if (i + 1 < text.Length && text[i] == '*' && text[i + 1] == '*')
            {
                int end = text.IndexOf("**", i + 2, StringComparison.Ordinal);
                if (end != -1)
                {
                    string inner = text.Substring(i + 2, end - i - 2);
                    paragraph.Inlines.Add(new Run(inner) { FontWeight = FontWeight.Bold });
                    i = end + 2;
                    continue;
                }
            }

            if (text[i] == '`')
            {
                int end = text.IndexOf('`', i + 1);
                if (end != -1)
                {
                    string inner = text.Substring(i + 1, end - i - 1);
                    paragraph.Inlines.Add(new Run(inner)
                    {
                        FontFamily = new FontFamily("Consolas, monospace"),
                        Background = isDark ? new SolidColorBrush(Color.Parse("#3A3A3E")) : new SolidColorBrush(Color.Parse("#E8E8E8")),
                        Foreground = isDark ? Brushes.LightGreen : Brushes.DarkRed
                    });
                    i = end + 1;
                    continue;
                }
            }

            if (text[i] == '*' && (i == 0 || text[i - 1] != '*') && (i + 1 >= text.Length || text[i + 1] != '*'))
            {
                int end = text.IndexOf('*', i + 1);
                if (end != -1)
                {
                    string inner = text.Substring(i + 1, end - i - 1);
                    paragraph.Inlines.Add(new Run(inner) { FontStyle = FontStyle.Italic });
                    i = end + 1;
                    continue;
                }
            }

            int nextSpecial = text.Length;
            int nextBold = text.IndexOf("**", i, StringComparison.Ordinal);
            int nextCode = text.IndexOf('`', i);
            int nextItalic = text.IndexOf('*', i);
            if (nextBold != -1) nextSpecial = Math.Min(nextSpecial, nextBold);
            if (nextCode != -1) nextSpecial = Math.Min(nextSpecial, nextCode);
            if (nextItalic != -1) nextSpecial = Math.Min(nextSpecial, nextItalic);

            if (nextSpecial <= i) nextSpecial = i + 1;
            paragraph.Inlines.Add(new Run(text.Substring(i, nextSpecial - i)));
            i = nextSpecial;
        }
    }
}