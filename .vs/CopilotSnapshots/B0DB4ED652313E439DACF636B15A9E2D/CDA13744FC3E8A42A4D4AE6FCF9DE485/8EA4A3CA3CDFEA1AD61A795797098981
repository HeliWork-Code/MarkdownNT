using Avalonia;
using Avalonia.Controls;
using Avalonia.Interactivity;
using Avalonia.Media;
using Avalonia.Platform.Storage;
using Avalonia.Styling;
using Avalonia.Threading;
using Avalonia.Controls.Documents;
using System;
using System.Collections.Generic;
using System.IO;
using System.Text.RegularExpressions;

namespace MarkdownNT
{
    public partial class MainWindow : Window
    {
        private DispatcherTimer? _autoSaveTimer;
        private string? _currentFilePath;
        private bool _isModified = false;

        public MainWindow()
        {
            InitializeComponent();
            InputBox.TextChanged += (s, e) =>
            {
                UpdatePreview();
                UpdateWordCount();
                _isModified = true;
            };

            // 自动保存定时器（每30秒）
            _autoSaveTimer = new DispatcherTimer
            {
                Interval = TimeSpan.FromSeconds(30)
            };
            _autoSaveTimer.Tick += (s, e) => AutoSave();
            _autoSaveTimer.Start();
        }

        // ========== 主题切换 ==========
        private void ToggleTheme_Click(object? sender, RoutedEventArgs e)
        {
            if (Application.Current != null)
            {
                if (Application.Current.RequestedThemeVariant == ThemeVariant.Dark)
                {
                    Application.Current.RequestedThemeVariant = ThemeVariant.Light;
                }
                else
                {
                    Application.Current.RequestedThemeVariant = ThemeVariant.Dark;
                }
                UpdatePreview();
            }
        }

        // ========== 文件操作 ==========
        private void NewFile_Click(object? sender, RoutedEventArgs e)
        {
            InputBox.Text = "";
            _currentFilePath = null;
            _isModified = false;
            StatusText.Text = "新建文件";
        }

        private async void OpenFile_Click(object? sender, RoutedEventArgs e)
        {
            var topLevel = TopLevel.GetTopLevel(this);
            if (topLevel == null) return;

            var files = await topLevel.StorageProvider.OpenFilePickerAsync(new FilePickerOpenOptions
            {
                Title = "打开 MarkdownNT 文件",
                AllowMultiple = false,
                FileTypeFilter = new[]
                {
                    new FilePickerFileType("MarkdownNT") { Patterns = new[] { "*.mdnt" } },
                    new FilePickerFileType("Markdown") { Patterns = new[] { "*.md" } },
                    new FilePickerFileType("所有文件") { Patterns = new[] { "*.*" } }
                }
            });

            if (files.Count >= 1)
            {
                var file = files[0];
                _currentFilePath = file.Path.LocalPath;
                using var stream = await file.OpenReadAsync();
                using var reader = new StreamReader(stream);
                InputBox.Text = await reader.ReadToEndAsync();
                _isModified = false;
                StatusText.Text = $"已打开: {Path.GetFileName(_currentFilePath)}";
            }
        }

        private async void SaveFile_Click(object? sender, RoutedEventArgs e)
        {
            await SaveFileAsync();
        }

        private async System.Threading.Tasks.Task SaveFileAsync()
        {
            var topLevel = TopLevel.GetTopLevel(this);
            if (topLevel == null) return;

            if (_currentFilePath == null)
            {
                var file = await topLevel.StorageProvider.SaveFilePickerAsync(new FilePickerSaveOptions
                {
                    Title = "保存 MarkdownNT 文件",
                    FileTypeChoices = new[] { new FilePickerFileType("MarkdownNT") { Patterns = new[] { "*.mdnt" } } },
                    SuggestedFileName = "笔记.mdnt",
                    DefaultExtension = "mdnt"
                });

                if (file == null) return;
                _currentFilePath = file.Path.LocalPath;
            }

            await using (var stream = File.Create(_currentFilePath))
            using (var writer = new StreamWriter(stream))
            {
                await writer.WriteAsync(InputBox.Text ?? "");
            }

            _isModified = false;
            StatusText.Text = $"已保存: {Path.GetFileName(_currentFilePath)}";
            AutoSaveText.Text = "自动保存: 已保存";
        }

        // ========== 自动保存 ==========
        private async void AutoSave()
        {
            if (string.IsNullOrEmpty(InputBox.Text)) return;

            string autoSaveDir = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
                "MarkdownNT");

            Directory.CreateDirectory(autoSaveDir);
            string autoSavePath = Path.Combine(autoSaveDir, "autosave.mdnt");

            await using (var stream = File.Create(autoSavePath))
            using (var writer = new StreamWriter(stream))
            {
                await writer.WriteAsync(InputBox.Text);
            }

            AutoSaveText.Text = $"自动 {DateTime.Now:HH:mm:ss}";
        }

        // ========== 字数统计 ==========
        private void UpdateWordCount()
        {
            string text = InputBox.Text ?? "";
            int charCount = text.Length;
            int wordCount = text.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
            WordCountText.Text = $"{charCount}字 / {wordCount}词";
        }

        // ========== 预览更新 ==========
        private void UpdatePreview()
        {
            PreviewPanel.Children.Clear();

            bool isDark = Application.Current?.RequestedThemeVariant == ThemeVariant.Dark;
            IBrush defaultForeground = isDark ? Brushes.White : Brushes.Black;

            string text = InputBox.Text ?? "";
            var lines = text.Split('\n');

            bool inCodeBlock = false;
            string codeLanguage = "";
            List<string> codeLines = new List<string>();

            bool inTable = false;
            List<string> tableLines = new List<string>();

            foreach (var line in lines)
            {
                string trimmed = line.TrimEnd('\r');

                // 代码块开始/结束
                if (trimmed.StartsWith(">>>"))
                {
                    // 先结束表格（如果有）
                    if (inTable)
                    {
                        RenderTable(tableLines, defaultForeground);
                        tableLines.Clear();
                        inTable = false;
                    }

                    if (inCodeBlock)
                    {
                        var codeBlock = MarkdownRenderer.RenderCodeBlock(codeLanguage, codeLines);
                        PreviewPanel.Children.Add(codeBlock);
                        inCodeBlock = false;
                        codeLines.Clear();
                        continue;
                    }
                    else
                    {
                        inCodeBlock = true;
                        codeLanguage = trimmed.Substring(3).Trim();
                        if (string.IsNullOrEmpty(codeLanguage)) codeLanguage = "text";
                        codeLines = new List<string>();
                        continue;
                    }
                }

                if (inCodeBlock)
                {
                    codeLines.Add(trimmed);
                    continue;
                }

                // 表格检测：以 | 开头
                if (trimmed.StartsWith("|") && trimmed.Contains("|"))
                {
                    inTable = true;
                    tableLines.Add(trimmed);
                    continue;
                }
                else if (inTable)
                {
                    // 结束表格
                    RenderTable(tableLines, defaultForeground);
                    tableLines.Clear();
                    inTable = false;
                    // 继续处理当前行（不 continue）
                }

                // 分割线
                if (Regex.IsMatch(trimmed, @"^\s*-{3,}\s*$"))
                {
                    var divider = new Border
                    {
                        Height = 1,
                        Background = isDark ? Brushes.Gray : Brushes.LightGray,
                        Margin = new Thickness(0, 8)
                    };
                    PreviewPanel.Children.Add(divider);
                    continue;
                }

                // 标题
                var headingMatch = Regex.Match(trimmed, @"^(#{1,6})\s+(.*)");
                if (headingMatch.Success)
                {
                    int level = headingMatch.Groups[1].Value.Length;
                    double size = 24 - level * 2;
                    var headerText = new TextBlock
                    {
                        Text = headingMatch.Groups[2].Value,
                        FontSize = size,
                        FontWeight = FontWeight.Bold,
                        Foreground = defaultForeground,
                        Margin = new Thickness(0, 4)
                    };
                    PreviewPanel.Children.Add(headerText);
                    continue;
                }

                // 引用块
                if (trimmed.StartsWith(">"))
                {
                    string quoteText = trimmed.Substring(1).Trim();
                    var quoteBorder = new Border
                    {
                        BorderBrush = isDark ? Brushes.DarkGray : Brushes.Silver,
                        BorderThickness = new Thickness(3, 0, 0, 0),
                        Padding = new Thickness(8, 4),
                        Margin = new Thickness(0, 4),
                        Background = isDark
                            ? new SolidColorBrush(Color.Parse("#2A2A2E"))
                            : new SolidColorBrush(Color.Parse("#F5F5F5"))
                    };
                    var quoteTextBlock = new TextBlock
                    {
                        Text = quoteText,
                        Foreground = isDark ? Brushes.LightGray : Brushes.DimGray,
                        FontStyle = FontStyle.Italic,
                        TextWrapping = TextWrapping.Wrap
                    };
                    quoteBorder.Child = quoteTextBlock;
                    PreviewPanel.Children.Add(quoteBorder);
                    continue;
                }

                // 列表项
                if (Regex.IsMatch(trimmed, @"^\s*[-*]\s+"))
                {
                    string listContent = trimmed.Substring(trimmed.IndexOf(' ') + 1);
                    var listItem = new TextBlock
                    {
                        Text = "• " + listContent,
                        Foreground = defaultForeground,
                        Margin = new Thickness(16, 0, 0, 2)
                    };
                    PreviewPanel.Children.Add(listItem);
                    continue;
                }

                // 特殊块 @meta / @audio / @speaker
                if (trimmed.StartsWith("@meta") || trimmed.StartsWith("@audio") || trimmed.StartsWith("@speaker"))
                {
                    var specialText = new TextBlock
                    {
                        Text = trimmed,
                        Foreground = Brushes.Purple,
                        FontWeight = FontWeight.Bold,
                        Margin = new Thickness(0, 2)
                    };
                    PreviewPanel.Children.Add(specialText);
                    continue;
                }

                // 普通段落，支持加粗、斜体、行内代码
                var paragraph = new TextBlock
                {
                    TextWrapping = TextWrapping.Wrap,
                    Foreground = defaultForeground,
                    Margin = new Thickness(0, 2)
                };

                RenderInline(paragraph, trimmed, isDark);
                PreviewPanel.Children.Add(paragraph);
            }

            // 结束时的表格
            if (inTable)
            {
                RenderTable(tableLines, defaultForeground);
            }

            // 结束时未闭合的代码块
            if (inCodeBlock)
            {
                var codeBlock = MarkdownRenderer.RenderCodeBlock(codeLanguage, codeLines);
                PreviewPanel.Children.Add(codeBlock);
            }
        }

        // ========== 内联渲染：加粗、斜体、行内代码 ==========
        pprivate void RenderInline(TextBlock paragraph, string text, bool isDark)
        {
            // 匹配加粗 **text**、行内代码 `code`、斜体 *text*
            // 注意：加粗优先，避免 ** 被拆分成两个 *
            string pattern = @"(\*\*.+?\*\*|`[^`]+`|\*[^*]+\*)";
            var regex = new Regex(pattern);
            var matches = regex.Matches(text);
            int lastIndex = 0;

            foreach (Match match in matches)
            {
                // 添加匹配之前的普通文本
                if (match.Index > lastIndex)
                {
                    paragraph.Inlines.Add(new Run(text.Substring(lastIndex, match.Index - lastIndex)));
                }

                string value = match.Value;

                if (value.StartsWith("**") && value.EndsWith("**") && value.Length >= 4)
                {
                    // 加粗：去掉前后两个星号
                    string inner = value.Substring(2, value.Length - 4);
                    paragraph.Inlines.Add(new Run(inner) { FontWeight = FontWeight.Bold });
                }
                else if (value.StartsWith("`") && value.EndsWith("`") && value.Length >= 2)
                {
                    // 行内代码
                    string inner = value.Substring(1, value.Length - 2);
                    paragraph.Inlines.Add(new Run(inner)
                    {
                        FontFamily = new FontFamily("Consolas, monospace"),
                        Background = isDark
                            ? new SolidColorBrush(Color.Parse("#3A3A3E"))
                            : new SolidColorBrush(Color.Parse("#E8E8E8")),
                        Foreground = isDark ? Brushes.LightGreen : Brushes.DarkRed
                    });
                }
                else if (value.StartsWith("*") && value.EndsWith("*") && value.Length >= 2)
                {
                    // 斜体
                    string inner = value.Substring(1, value.Length - 2);
                    paragraph.Inlines.Add(new Run(inner) { FontStyle = FontStyle.Italic });
                }
                else
                {
                    paragraph.Inlines.Add(new Run(value));
                }

                lastIndex = match.Index + match.Length;
            }

            // 添加最后剩余的普通文本
            if (lastIndex < text.Length)
            {
                paragraph.Inlines.Add(new Run(text.Substring(lastIndex)));
            }

            // 如果没有任何匹配，直接添加整行
            if (paragraph.Inlines.Count == 0)
            {
                paragraph.Inlines.Add(new Run(text));
            }
        }

        // ========== 表格渲染 ==========
        private void RenderTable(List<string> tableLines, IBrush defaultForeground)
        {
            if (tableLines.Count == 0) return;

            bool isDark = Application.Current?.RequestedThemeVariant == ThemeVariant.Dark;

            var tableBorder = new Border
            {
                BorderBrush = isDark ? Brushes.DarkGray : Brushes.Silver,
                BorderThickness = new Thickness(1),
                CornerRadius = new CornerRadius(4),
                Padding = new Thickness(8),
                Margin = new Thickness(0, 4),
                Background = isDark
                    ? new SolidColorBrush(Color.Parse("#2A2A2E"))
                    : new SolidColorBrush(Color.Parse("#FAFAFA"))
            };

            var tableStack = new StackPanel { Spacing = 2 };
            tableBorder.Child = tableStack;

            foreach (var line in tableLines)
            {
                string trimmed = line.Trim();
                // 跳过分隔行（| --- | --- |）
                if (Regex.IsMatch(trimmed, @"^\|[\s\-\|]+\|$"))
                {
                    // 添加一条细线
                    var separator = new Border
                    {
                        Height = 1,
                        Background = isDark ? Brushes.Gray : Brushes.LightGray,
                        Margin = new Thickness(0, 2)
                    };
                    tableStack.Children.Add(separator);
                    continue;
                }

                var rowText = new TextBlock
                {
                    Text = trimmed,
                    FontFamily = new FontFamily("Consolas, monospace"),
                    Foreground = defaultForeground,
                    TextWrapping = TextWrapping.NoWrap
                };
                tableStack.Children.Add(rowText);
            }

            PreviewPanel.Children.Add(tableBorder);
        }
    }
}